{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.zyqwax.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.zyqwax.com"
      }
    },
    "development-apk": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.zyqwax.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.zyqwax.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.zyqwax.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.zyqwax.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.zyqwax.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.zyqwax.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}